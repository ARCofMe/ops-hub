# Core Discord bot settings.
OPS_HUB_DISCORD_TOKEN=
OPS_HUB_GUILD_ID=

# Admins can use debug/config/mapping commands.
OPS_HUB_ADMIN_USER_IDS=[]
OPS_HUB_ADMIN_ROLE_IDS=[]

# Technicians can use technician workflows like /job, /assignments, and /part_request.
OPS_HUB_TECHNICIAN_USER_IDS=[]
OPS_HUB_TECHNICIAN_ROLE_IDS=[]

# Parts can use queue-management commands like /part, /part_requests, /part_claim, and /part_update.
OPS_HUB_PARTS_USER_IDS=[]
OPS_HUB_PARTS_ROLE_IDS=[]

# Dispatchers can use dispatch-facing lookup commands like /job, /tech_assignments, and /tech_job.
OPS_HUB_DISPATCHER_USER_IDS=[]
OPS_HUB_DISPATCHER_ROLE_IDS=[]

# Discord user id -> BlueFolder user id mapping.
OPS_HUB_TECHNICIAN_BLUEFOLDER_USER_MAP={}

# Optional JSON file used to export/import technician mappings.
OPS_HUB_TECHNICIAN_MAPPING_FILE=

# Optional JSON file for lightweight Ops Hub parts request tracking.
# Leave blank to keep the request store in-memory only.
OPS_HUB_PARTS_REQUEST_FILE=

# Optional Discord channel for Ops Hub notices.
# If set, notices can be routed into Discord instead of remaining logger-only.
OPS_HUB_NOTIFICATION_CHANNEL_ID=

# Optional topic-prefix routing for notices.
# Example: {"parts": 123456789012345678, "dispatch": 234567890123456789}
# Topics matching "<prefix>.*" will route to that channel before falling back
# to OPS_HUB_NOTIFICATION_CHANNEL_ID.
OPS_HUB_NOTIFICATION_CHANNEL_MAP={}

# Runtime behavior.
OPS_HUB_LOG_LEVEL=INFO
OPS_HUB_ENVIRONMENT=dev
OPS_HUB_ENABLE_MESSAGE_CONTENT_INTENT=true
OPS_HUB_PHOTO_INGEST_CHANNEL_ID=
# Optional JSON file for admin-controlled photo feature overrides.
# This lets you toggle photo workflows live without editing the main .env.
OPS_HUB_PHOTO_FEATURE_FLAGS_FILE=
OPS_HUB_PHOTO_COMPRESS_MAX_DIMENSION=1800
OPS_HUB_PHOTO_COMPRESS_JPEG_QUALITY=82
OPS_HUB_PHOTO_COMPRESS_MAX_MB=5
# Default photo workflow feature gates. Admin overrides can supersede these
# when OPS_HUB_PHOTO_FEATURE_FLAGS_FILE is configured.
OPS_HUB_ENABLE_MDLSN_UPLOAD=true
OPS_HUB_ENABLE_PHOTO_ARCHIVE_HANDOFF=true
OPS_HUB_ENABLE_PHOTO_MAILBOX_SCAN=false
OPS_HUB_ENABLE_WEEKLY_MISSING_PHOTO_NOTICES=false

# Existing local project/library roots that Ops Hub wraps incrementally.
# Point these at repo roots, not individual files.
OPS_HUB_BLUEFOLDER_API_PATH=

# BlueFolder credentials for read-only lookups. Set account name or base URL, not both.
OPS_HUB_BLUEFOLDER_API_KEY=
OPS_HUB_BLUEFOLDER_ACCOUNT_NAME=
OPS_HUB_BLUEFOLDER_BASE_URL=
OPS_HUB_BLUEFOLDER_HOST_HEADER=
OPS_HUB_BLUEFOLDER_VERIFY_SSL=
OPS_HUB_BLUEFOLDER_TIMEOUT_SECONDS=

# Future local wrapper roots.
# If OPS_HUB_PARTS_CANNON_PROJECT_PATH is set, /part_sync exports
# tracked requests to <that path>/ops_hub_exports/parts_requests.json.
# /part_reconcile reads downstream updates from
# <that path>/ops_hub_exports/parts_request_receipts.json.
OPS_HUB_BLUEBOT_DISCORD_EXTENSION_PATH=
OPS_HUB_PHOTO_INGEST_PROJECT_PATH=
# Optional SMTP handoff for archived job photos. This supports the current
# email-based photo flow while mailbox polling/compliance checks are still future work.
OPS_HUB_PHOTO_ARCHIVE_SMTP_HOST=
OPS_HUB_PHOTO_ARCHIVE_SMTP_PORT=
OPS_HUB_PHOTO_ARCHIVE_SMTP_USERNAME=
OPS_HUB_PHOTO_ARCHIVE_SMTP_PASSWORD=
OPS_HUB_PHOTO_ARCHIVE_SMTP_USE_TLS=true
OPS_HUB_PHOTO_ARCHIVE_FROM_EMAIL=
OPS_HUB_PHOTO_ARCHIVE_TO_EMAIL=
# Optional IMAP mailbox scan for photo compliance. Subject matching currently
# looks for "SR-<id>" within the email subject and counts image attachments.
OPS_HUB_PHOTO_MAILBOX_IMAP_HOST=
OPS_HUB_PHOTO_MAILBOX_IMAP_PORT=
OPS_HUB_PHOTO_MAILBOX_IMAP_USERNAME=
OPS_HUB_PHOTO_MAILBOX_IMAP_PASSWORD=
OPS_HUB_PHOTO_MAILBOX_IMAP_USE_SSL=true
OPS_HUB_PHOTO_MAILBOX_FOLDER=INBOX
OPS_HUB_PHOTO_MAILBOX_SEARCH_DAYS=21
# Optional list of BlueFolder SR statuses that should require photos.
# Example: ["Completed", "Pending Photo Review"]
OPS_HUB_PHOTO_REQUIRED_SR_STATUSES=[]
# Required compliance tags looked for in archived photo filenames.
# Example filenames like model.jpg or serial_tag.jpeg will satisfy these.
OPS_HUB_PHOTO_REQUIRED_TAGS=["model","serial"]
OPS_HUB_PARTS_CANNON_PROJECT_PATH=
OPS_HUB_DISPATCH_PROJECT_PATH=
