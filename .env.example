# Core Discord bot settings.
OPS_HUB_DISCORD_TOKEN=
OPS_HUB_GUILD_ID=

# Admins can use debug/config/mapping commands.
OPS_HUB_ADMIN_USER_IDS=[]
OPS_HUB_ADMIN_ROLE_IDS=[]

# Operators can use field workflow commands like /job and /part.
OPS_HUB_OPERATOR_USER_IDS=[]
OPS_HUB_OPERATOR_ROLE_IDS=[]

# Parts can use parts-facing commands like /part.
OPS_HUB_PARTS_USER_IDS=[]
OPS_HUB_PARTS_ROLE_IDS=[]

# Dispatchers can use dispatch-facing commands like /job.
OPS_HUB_DISPATCHER_USER_IDS=[]
OPS_HUB_DISPATCHER_ROLE_IDS=[]

# Discord user id -> BlueFolder user id mapping.
OPS_HUB_OPERATOR_BLUEFOLDER_USER_MAP={}

# Optional JSON file used to export/import operator mappings.
OPS_HUB_OPERATOR_MAPPING_FILE=

# Runtime behavior.
OPS_HUB_LOG_LEVEL=INFO
OPS_HUB_ENVIRONMENT=dev
OPS_HUB_PHOTO_INGEST_CHANNEL_ID=

# Existing local project/library roots that Ops Hub wraps incrementally.
# Point these at repo roots, not individual files.
OPS_HUB_BLUEFOLDER_API_PATH=

# BlueFolder credentials for read-only lookups. Set account name or base URL, not both.
OPS_HUB_BLUEFOLDER_API_KEY=
OPS_HUB_BLUEFOLDER_ACCOUNT_NAME=
OPS_HUB_BLUEFOLDER_BASE_URL=

# Future local wrapper roots.
OPS_HUB_BLUEBOT_DISCORD_EXTENSION_PATH=
OPS_HUB_PHOTO_INGEST_PROJECT_PATH=
OPS_HUB_PARTS_CANNON_PROJECT_PATH=
OPS_HUB_DISPATCH_PROJECT_PATH=
